# Integration Adapter environment — copy to /docker/breakout/adapter.env (chmod 600).
# This file is the ONLY place the OpenAlgo key lives. Use a dedicated OpenAlgo
# user for Breakout so revoking it does not affect TradeOS.
OPENALGO_BASE_URL=
OPENALGO_API_KEY=
# Same value as MARKETDATA_ADAPTER_HMAC_KEY in Breakout's .env (≥32 chars):
#   openssl rand -hex 32
ADAPTER_HMAC_KEY=
ADAPTER_PORT=8790
