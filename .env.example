# Breakout configuration template.
# Copy to .env (chmod 600) and fill in real values. Never commit .env.
# Do NOT copy OpenAlgo or TradeOS secrets here. Those integrations are disabled
# in Release 1; their credentials will belong to the separately reviewed
# Integration Adapter, not to the Copilot.

# --- Identity --------------------------------------------------------------
# Compose project name. Must stay "breakout"; scripts/breakoutctl enforces it.
COMPOSE_PROJECT_NAME=breakout
BREAKOUT_ENV=development            # development | staging | production
BREAKOUT_LOG_LEVEL=info             # debug | info | warn | error

# --- HTTP ------------------------------------------------------------------
# Host port for the container (published on 127.0.0.1 only). Public exposure
# goes through a separately reviewed reverse-proxy change.
BREAKOUT_HOST_PORT=
# Exact origin the browser uses (scheme://host[:port]). State-changing
# requests from any other Origin are refused.
BREAKOUT_PUBLIC_ORIGIN=http://127.0.0.1:8787
# true behind HTTPS; false only for local http testing.
BREAKOUT_COOKIE_SECURE=true
BREAKOUT_SESSION_TTL_HOURS=12

# --- Local (non-container) runs only; compose.yaml fixes these in the container
BREAKOUT_HTTP_BIND=127.0.0.1
BREAKOUT_HTTP_PORT=8787
BREAKOUT_DB_PATH=/docker/breakout/runtime/data/breakout.db
BREAKOUT_STATIC_DIR=/docker/breakout/frontend/dist

# --- Limits ----------------------------------------------------------------
BREAKOUT_CHAT_RATE_PER_MIN=12
BREAKOUT_LOGIN_RATE_PER_MIN=5

# --- Adorbis AI Gateway (server-side only) ---------------------------------
# Dedicated Breakout key from the Adorbis account. Never the TradeOS key.
ADORBIS_API_KEY=
ADORBIS_BASE_URL=https://api.adorbistech.com/v1
# Published identifiers (https://ai.adorbistech.com/docs). adorbis/auto is an
# alias that currently resolves to adorbis/writing; it is not dynamic routing.
ADORBIS_MODELS=adorbis/quick,adorbis/writing,adorbis/coder,adorbis/auto
ADORBIS_DEFAULT_MODEL=adorbis/quick
ADORBIS_TIMEOUT_MS=90000
ADORBIS_MAX_OUTPUT_TOKENS=2048

# --- TradeOS -----------------------------------------------------------------
# Read Contract v1 (target). Unset = "not connected". The token is a dedicated
# read-only service credential; NOT provisioned in TradeOS as of 2026-11-14.
TRADEOS_BASE_URL=
TRADEOS_SERVICE_TOKEN=
TRADEOS_TIMEOUT_MS=5000
# Bridge: read-only GETs on an allowlist of today's
# unversioned TradeOS routes. Requires TRADEOS_BASE_URL on loopback/private
# network (public hostnames are refused). Off by default.
TRADEOS_BRIDGE_ENABLED=false

# --- Alerts (TradeOS ntfy topic, read-only poll) --------------------------------
# Use a read-only token if the ntfy server enforces access control.
NTFY_BASE_URL=
NTFY_TOPIC=breakout-alerts
NTFY_TOKEN=
NTFY_POLL_SECONDS=30

# --- Market data via the Integration Adapter (adapter/, opt-in profile) --------
# Breakout holds only the HMAC key shared with the adapter, never an OpenAlgo key.
MARKETDATA_ADAPTER_URL=
MARKETDATA_ADAPTER_HMAC_KEY=
MARKETDATA_TIMEOUT_MS=3000

# --- Accounts -------------------------------------------------------------------
# closed = accounts created with backend/src/cli.ts; open = public sign-up.
BREAKOUT_REGISTRATION=closed
# Development only: synthetic candles, watermarked DEMO. Never in production.
BREAKOUT_DEMO_DATA=false
