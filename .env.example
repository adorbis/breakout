# Breakout configuration template.
# Copy to .env (chmod 600) and fill in real values. Never commit .env.
# Do NOT copy OpenAlgo or TradeOS secrets here until the private integration
# path is designed and reviewed. No service reads these values yet.

# --- Identity --------------------------------------------------------------
# Compose project name. Must stay "breakout"; scripts/breakoutctl enforces it.
COMPOSE_PROJECT_NAME=breakout
BREAKOUT_ENV=development            # development | staging | production
BREAKOUT_LOG_LEVEL=info             # debug | info | warning | error

# --- Network exposure ------------------------------------------------------
# Bind to loopback only; public exposure goes through a separately reviewed
# reverse-proxy change. No ports are published at this stage.
BREAKOUT_HTTP_BIND=127.0.0.1
BREAKOUT_HTTP_PORT=0                # 0 = not assigned yet

# --- Health check ----------------------------------------------------------
# URL scripts/breakoutctl health probes once the app exists (blank = skip).
BREAKOUT_HEALTH_URL=

# --- Upstream services (consumed read-only; Release 1 places no orders) ----
OPENALGO_BASE_URL=                  # private path, to be designed
OPENALGO_API_KEY=__set_me__         # placeholder; read-only scope only
TRADEOS_BASE_URL=                   # decision authority; read-only consumer
COLLECTOR_BASE_URL=

# --- Application secrets ---------------------------------------------------
BREAKOUT_SECRET_KEY=__generate_me__ # e.g. openssl rand -hex 32
